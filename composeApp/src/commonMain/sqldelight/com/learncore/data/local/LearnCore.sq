-- LearnCore Database Schema
-- Tasks table with Eisenhower quadrant classification

CREATE TABLE TaskEntity (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    title TEXT NOT NULL,
    category TEXT NOT NULL DEFAULT '',
    description TEXT NOT NULL DEFAULT '',
    quadrant TEXT NOT NULL DEFAULT 'DO_FIRST',
    is_completed INTEGER NOT NULL DEFAULT 0,
    deadline INTEGER,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

-- Pomodoro sessions table
CREATE TABLE PomodoroSessionEntity (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    task_id INTEGER,
    duration_seconds INTEGER NOT NULL,
    completed_at INTEGER NOT NULL
);

-- ==================== TASK QUERIES ====================

getAllTasks:
SELECT * FROM TaskEntity
ORDER BY is_completed ASC, updated_at DESC;

getTasksByQuadrant:
SELECT * FROM TaskEntity
WHERE quadrant = ?
ORDER BY is_completed ASC, updated_at DESC;

getActiveTasks:
SELECT * FROM TaskEntity
WHERE is_completed = 0
ORDER BY updated_at DESC;

getTaskById:
SELECT * FROM TaskEntity
WHERE id = ?;

insertTask:
INSERT INTO TaskEntity (title, category, description, quadrant, is_completed, deadline, created_at, updated_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

lastInsertId:
SELECT last_insert_rowid();

updateTask:
UPDATE TaskEntity
SET title = ?, category = ?, description = ?, quadrant = ?, deadline = ?, updated_at = ?
WHERE id = ?;

toggleTaskCompletion:
UPDATE TaskEntity
SET is_completed = CASE WHEN is_completed = 1 THEN 0 ELSE 1 END, updated_at = ?
WHERE id = ?;

deleteTaskById:
DELETE FROM TaskEntity
WHERE id = ?;

countByQuadrant:
SELECT quadrant, COUNT(*) AS count
FROM TaskEntity
WHERE is_completed = 0
GROUP BY quadrant;

countCompleted:
SELECT COUNT(*) FROM TaskEntity WHERE is_completed = 1;

countTotal:
SELECT COUNT(*) FROM TaskEntity;

-- ==================== POMODORO QUERIES ====================

insertPomodoroSession:
INSERT INTO PomodoroSessionEntity (task_id, duration_seconds, completed_at)
VALUES (?, ?, ?);

getTotalFocusSeconds:
SELECT COALESCE(SUM(duration_seconds), 0) FROM PomodoroSessionEntity;

getSessionsCount:
SELECT COUNT(*) FROM PomodoroSessionEntity;

getRecentSessions:
SELECT ps.*, t.title AS task_title
FROM PomodoroSessionEntity ps
LEFT JOIN TaskEntity t ON ps.task_id = t.id
ORDER BY ps.completed_at DESC
LIMIT 10;
